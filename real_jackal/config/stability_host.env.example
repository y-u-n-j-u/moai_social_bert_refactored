# Source on the lab host, after auditing the existing container's mounts.
# This file only exports settings. It does not start/stop any process, configure
# networking, change BASE_IMAGE/OUTPUT_IMAGE, or arm the robot.
# Explicit environment overrides are kept. Verify each path against mounts.json.
export CONTAINER_NAME="${CONTAINER_NAME:-moai_jackal_spubert_stability}"
export CAPSTONE_CALIB="${CAPSTONE_CALIB:-/home/capstone_navi/spu_deploy_docker/context/calib}"
export MAP_DIR="${MAP_DIR:-$HOME/jackal_maps}"
export LOG_DIR="${LOG_DIR:-$HOME/jackal_logs}"
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-1}"
export JACKAL_INTERFACE="${JACKAL_INTERFACE:-enp131s0}"
export MOAI_ENABLE_GUI="${MOAI_ENABLE_GUI:-1}"
export DISPLAY="${DISPLAY:-:0}"
