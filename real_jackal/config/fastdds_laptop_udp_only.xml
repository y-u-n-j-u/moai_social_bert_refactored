<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!--
    The deployment container uses the host network but a private IPC namespace.
    Keep this participant on UDP so Fast DDS cannot select an SHM locator that
    is inaccessible across the laptop/container IPC boundary.
  -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>jackal_udp</transport_id>
      <type>UDPv4</type>
      <maxInitialPeersRange>100</maxInitialPeersRange>
      <interfaceWhiteList>
        <address>192.168.50.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="jackal_network_laptop_udp_only" is_default_profile="true">
    <rtps>
      <builtin>
        <discovery_config>
          <discoveryProtocol>SIMPLE</discoveryProtocol>
        </discovery_config>
        <avoid_builtin_multicast>true</avoid_builtin_multicast>
        <metatrafficUnicastLocatorList>
          <locator><udpv4><address>192.168.50.1</address></udpv4></locator>
        </metatrafficUnicastLocatorList>
        <initialPeersList>
          <locator><udpv4><address>192.168.50.1</address></udpv4></locator>
          <locator><udpv4><address>192.168.50.2</address></udpv4></locator>
          <locator><udpv4><address>192.168.50.3</address></udpv4></locator>
        </initialPeersList>
      </builtin>
      <userTransports>
        <transport_id>jackal_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
