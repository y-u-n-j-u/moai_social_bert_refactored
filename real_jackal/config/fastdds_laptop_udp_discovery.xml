<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!--
    UDP-only user traffic plus PDP multicast discovery compatibility for DDS
    participants created by the Micro XRCE-DDS Agent.  The interface whitelist
    confines all traffic from this profile to the direct Jackal link.
  -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>jackal_udp</transport_id>
      <type>UDPv4</type>
      <maxInitialPeersRange>100</maxInitialPeersRange>
      <interfaceWhiteList>
        <address>192.168.50.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="jackal_network_laptop_udp_discovery" is_default_profile="true">
    <rtps>
      <builtin>
        <discovery_config>
          <discoveryProtocol>SIMPLE</discoveryProtocol>
        </discovery_config>
        <avoid_builtin_multicast>true</avoid_builtin_multicast>
        <metatrafficUnicastLocatorList>
          <locator><udpv4><address>192.168.50.1</address></udpv4></locator>
        </metatrafficUnicastLocatorList>
        <metatrafficMulticastLocatorList>
          <locator><udpv4><address>239.255.0.1</address></udpv4></locator>
        </metatrafficMulticastLocatorList>
        <initialPeersList>
          <locator><udpv4><address>192.168.50.1</address></udpv4></locator>
          <locator><udpv4><address>192.168.50.2</address></udpv4></locator>
          <locator><udpv4><address>192.168.50.3</address></udpv4></locator>
        </initialPeersList>
      </builtin>
      <userTransports>
        <transport_id>jackal_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
